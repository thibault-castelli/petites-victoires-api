@host=https://localhost
@port=7280
@base=/api

### Create user
POST {{host}}:{{port}}{{base}}/users
Content-Type: application/json

{
  "EmailAddress": "example2@mail.com",
  "Name": "example2",
  "Password": "Password1!"
}

### Update user
PUT {{host}}:{{port}}{{base}}/users/1
Content-Type: application/json

{
  "EmailAddress": "new-example@mail.com",
  "Name": "new-example",
  "CurrentPassword": "Password1!",
  "NewPassword": "Password2?"
}

### Delete user
DELETE {{host}}:{{port}}{{base}}/users/1

### Get user
GET {{host}}:{{port}}{{base}}/users/1

### Get user like stats
GET {{host}}:{{port}}{{base}}/users/1/like-stats

### List users
GET {{host}}:{{port}}{{base}}/users?page=1

### Sign in
POST {{host}}:{{port}}{{base}}/users/sign-in
Content-Type: application/json

{
  "EmailAddress": "example@mail.com",
  "Password": "Password123!"
}

### Sign out
POST {{host}}:{{port}}{{base}}/users/sign-out

### GET post
GET {{host}}:{{port}}{{base}}/posts/2

### List posts
GET {{host}}:{{port}}{{base}}/posts?page=1&sort_by=likes_count

### Create post
POST {{host}}:{{port}}{{base}}/posts
Content-Type: application/json

{
  "Content": "Test"
}

### Update post
PUT {{host}}:{{port}}{{base}}/posts/3
Content-Type: application/json

{
  "PostContent": "new content"
}

### Delete post
DELETE {{host}}:{{port}}{{base}}/posts/3

### Create like
POST {{host}}:{{port}}{{base}}/likes
Content-Type: application/json

{
  "PostId": 2
}

### Delete like
DELETE {{host}}:{{port}}{{base}}/likes
Content-Type: application/json

{
  "PostId": 2
}
